{
  "name": "@photo-culler/desktop",
  "version": "0.0.0-dev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/p5hema2/photo-culler.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint": "eslint src/",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "package": "pnpm vendor && electron-builder",
    "package:mac": "pnpm vendor:mac && electron-builder --mac",
    "package:win": "pnpm vendor:win && electron-builder --win",
    "icons": "node scripts/make-icons.mjs",
    "vendor": "node scripts/vendor-native-deps.mjs",
    "vendor:win": "node scripts/vendor-native-deps.mjs --target win-x64",
    "vendor:mac": "node scripts/vendor-native-deps.mjs --target mac-x64 --target mac-arm64"
  },
  "dependencies": {
    "@photo-culler/image-utils": "workspace:*",
    "@tanstack/react-virtual": "^3.13.22",
    "electron-store": "^11.0.2",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^37.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@photo-culler/tsconfig": "workspace:*",
    "@photo-culler/types": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.0",
    "electron-vite": "^3.1.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
